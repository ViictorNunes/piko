package app.crimera.patches.instagram.misc.theme

import app.crimera.patches.instagram.utils.Constants.COMPATIBILITY_INSTAGRAM
import app.morphe.patcher.Fingerprint
import app.morphe.patcher.extensions.InstructionExtensions.instructions
import app.morphe.patcher.extensions.InstructionExtensions.replaceInstruction
import app.morphe.patcher.patch.bytecodePatch
import com.android.tools.smali.dexlib2.Opcode
import com.android.tools.smali.dexlib2.iface.instruction.OneRegisterInstruction
import com.android.tools.smali.dexlib2.iface.instruction.ReferenceInstruction
import com.android.tools.smali.dexlib2.iface.reference.FieldReference

private const val PRISM_COLORS_V2_CLASS = "Lcom/instagram/compose/core/theme/BasePrismColorsV2;"
private const val GRAY_1600_FIELD_NAME = "GRAY_1600"
private const val PURE_BLACK_LITERAL = "0xff000000L"

// No distinguishing string literal exists inside a <clinit>, so this matches
// directly by class + method name instead of the `strings` shortcut used by
// DisableAdsFingerprint. Confirm `custom` is the right constructor param name
// for Fingerprint in this Morphe version - it's the standard revanced-patcher
// name, but forks occasionally rename it.
internal object BasePrismColorsV2ClinitFingerprint : Fingerprint(
    custom = { method, classDef ->
        classDef.type == PRISM_COLORS_V2_CLASS && method.name == "<clinit>"
    },
)

@Suppress("unused")
val amoledPrismComposeGray1600Patch =
    bytecodePatch(
        name = "AMOLED prism Compose GRAY_1600",
        default = true,
    ) {
        compatibleWith(COMPATIBILITY_INSTAGRAM)

        execute {
            BasePrismColorsV2ClinitFingerprint.method.apply {
                val sputIndex = instructions.indexOfFirst { instruction ->
                    instruction.opcode == Opcode.SPUT_WIDE &&
                        (instruction as? ReferenceInstruction)?.reference
                            ?.let { it as? FieldReference }
                            ?.let { it.definingClass == PRISM_COLORS_V2_CLASS && it.name == GRAY_1600_FIELD_NAME } == true
                }

                if (sputIndex == -1) return@apply

                // Walk backwards to the const-wide feeding that sput-wide. A
                // shl-long/2addr sits in between (packing the ARGB value into
                // Compose's internal 64-bit color representation) and is left
                // untouched - only the literal itself needs to change.
                for (index in sputIndex - 1 downTo 0) {
                    val instruction = instructions[index]

                    if (instruction.opcode == Opcode.CONST_WIDE) {
                        val register = (instruction as OneRegisterInstruction).registerA
                        replaceInstruction(index, "const-wide v$register, $PURE_BLACK_LITERAL")
                        break
                    }

                    // Ran into the previous field's own assignment without
                    // finding a const-wide - bail rather than touch the wrong slot.
                    if (instruction.opcode == Opcode.SPUT_WIDE) break
                }
            }
        }
    }
